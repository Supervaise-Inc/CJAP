#!/usr/bin/env bash
# sv-robot — switch the DGX Spark between office mode (Qwen API for the team)
# and robot mode (CJAP + Reachy Mini Lite + local voice).
#
#   sv-robot on       save the LLM split, stop Qwen, start cjap-tts, the Reachy
#                     daemon, CJAP (supervaise), its dashboard and the Whisper keepalive
#   sv-robot off      stop all of that and restore the saved split
#   sv-robot status   what is running now
#
# Needs your sudo password for the systemd units. Safe to run twice.
set -u
RUN=~/robot/run
SAVED=$RUN/split-before.json
UNITS="reachy-daemon supervaise pi-dashboard cjap-whisper-keepalive"
mkdir -p "$RUN"

health() { curl -s -m 3 http://127.0.0.1:8091/health 2>/dev/null; }

wait_tts() {
  echo "waiting for cjap-tts (model load + warmup, up to 5 min)..."
  for _ in $(seq 1 60); do
    if health | grep -q '"ok":true'; then echo "cjap-tts ready: $(health)"; return 0; fi
    sleep 5
  done
  echo "cjap-tts not ready after 5 min — see: docker logs sv-robot-cjap-tts-1 --tail 50"
  return 1
}

restore_args() {
  python3 - "$SAVED" <<'EOF'
import json, sys
j = json.load(open(sys.argv[1]))
p = j.get("pct", {})
print(" ".join(f"{k}={int(round(float(p.get(k, 0))))}" for k in ("qwen", "lfm", "embed"))
      + f" ctx={int(j.get('ctx', 131072))}")
EOF
}

case "${1:-status}" in
  on)
    if [ "$(cat $RUN/MODE 2>/dev/null)" = robot ]; then
      echo "already in robot mode (split saved in $SAVED)"
    else
      cp ~/llm/splits/current.json "$SAVED" || { echo "cannot save the split"; exit 1; }
      echo "saved split: $(cat "$SAVED")"
      ~/bin/sv-split qwen=0 lfm=0 embed=0 || { echo "sv-split failed — nothing else changed"; exit 1; }
      echo robot > $RUN/MODE
    fi
    ( cd ~/Supervaise-Reachy-Mini-Project-main/deploy/spark/compose && docker compose up -d cjap-tts ) || exit 1
    wait_tts || exit 1
    sudo systemctl start $UNITS || exit 1
    sleep 2
    systemctl --no-pager --lines=0 status $UNITS | grep -E '^●|Active:'
    echo "robot mode ON. Console: http://192.168.1.201:8180/console?key=<your key>"
    ;;
  off)
    sudo systemctl stop supervaise cjap-whisper-keepalive pi-dashboard reachy-daemon
    ( cd ~/Supervaise-Reachy-Mini-Project-main/deploy/spark/compose && docker compose stop cjap-tts )
    if [ -f "$SAVED" ]; then
      ARGS=$(restore_args) && echo "restoring split: $ARGS" && ~/bin/sv-split $ARGS
    else
      echo "no saved split in $SAVED — run 'sv-split apply' or set it by hand"
    fi
    echo office > $RUN/MODE
    echo "robot mode OFF."
    ;;
  status)
    echo "mode: $(cat $RUN/MODE 2>/dev/null || echo office)"
    systemctl --no-pager --lines=0 status $UNITS 2>/dev/null | grep -E '^●|Active:'
    echo "cjap-tts: $(health || echo down)"
    ~/bin/sv-split 2>/dev/null | head -8
    ;;
  *)
    echo "usage: sv-robot on|off|status"; exit 2 ;;
esac
