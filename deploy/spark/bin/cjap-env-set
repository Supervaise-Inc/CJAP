#!/usr/bin/env python3
"""cjap-env-set — set one line in CJAP's app/.env without the value appearing in
your shell history or on screen.

    cjap-env-set NAME          asks for the value (hidden), e.g. ANTHROPIC_API_KEY
    cjap-env-set NAME VALUE    for values that are not secret
    cjap-env-set --show        lists the NAMES that are set (never the values)

Replaces an existing NAME= line or appends one; keeps the file mode 600.
"""
import getpass
import os
import re
import sys

ENV = os.path.expanduser("~/Supervaise-Reachy-Mini-Project-main/app/.env")


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    lines = open(ENV, encoding="utf-8").read().splitlines() if os.path.exists(ENV) else []
    if sys.argv[1] == "--show":
        for ln in lines:
            m = re.match(r"^([A-Z0-9_]+)=(.*)$", ln)
            if m:
                print(f"{m.group(1)}={'(set)' if m.group(2).strip() else '(empty)'}")
        return 0
    name = sys.argv[1]
    if not re.fullmatch(r"[A-Z][A-Z0-9_]*", name):
        print(f"not a variable name: {name}")
        return 2
    value = sys.argv[2] if len(sys.argv) > 2 else getpass.getpass(f"{name}: ").strip()
    if not value:
        print("empty value — nothing changed")
        return 1
    out, done = [], False
    for ln in lines:
        if ln.startswith(name + "="):
            if not done:
                out.append(f"{name}={value}")
                done = True
            continue                      # drop duplicates of the same name
        out.append(ln)
    if not done:
        out.append(f"{name}={value}")
    fd = os.open(ENV, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    os.chmod(ENV, 0o600)
    print(f"{name} set in {ENV}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
