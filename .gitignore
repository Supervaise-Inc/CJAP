# Secrets — NEVER commit
.env
.env.local
*.key
**/.env
**/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.pytest_cache/
**/.venv/
# PLAN-0008 training venv (sibling to the kiosk runtime venv —
# isolated so torch/audiomentations/openwakeword don't bloat the
# runtime image). Multi-gigabyte; never committed.
**/.venv-training/
# Legacy venv snapshots kept as fallback during the D:→C: consolidation
# (and any future venv migration). Never committed.
**/.venv.old/

# Large model/binary assets (each user installs locally)
app/voices/*.onnx
app/voices/*.onnx.json
app/piper/
**/piper/piper.exe
**/piper/*.dll
**/piper/espeak-ng-data/

# Whisper model cache
.cache/
models/
# But DO commit the trained wake-word classifier — it's the runtime
# artefact we ship. ~210 kB single ONNX. Exempt this specific path
# from the generic `models/` rule above.
!app/wake/models/
!app/wake/models/*.onnx

# Temp audio
*.wav
*.mp3
!sample_*.wav

# Dashboard runtime state (regenerated by the CLI each turn)
app/state/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Claude Code per-project local settings (machine-specific)
.claude/settings.local.json
# Claude Code per-project session/state cache (machine-specific)
.claude/

# ElevenLabs voice module — local credentials + clip cache
voice/config.py
voice/.voice_cache/
.voice_cache/

# Fresh-robot bundle: the small clip pools (~13 MB, no secrets) ARE shipped —
# deploy/pi/install.sh copies them to ~/fillers, ~/fillers_ack, ~/fillers_bail,
# ~/demo_clips. The *.wav rule above stays for everything else.
!deploy/pi/audio/**/*.wav

# Large, regenerable index files (mirrors the working repo) — keep out of git
# W1.6 sparse BM25 index — regenerate with scripts/build_sparse_index.py
data/index/pilot_sparse.pkl
# W1.7 full-corpus dense matrix (~30MB) — regenerate with build_corpus_dense.py
data/index/corpus_dense.npy
# archived bge-large rollback matrix (~36MB) — keep locally / release asset, not in git
data/index/_archived_bgelarge_corpus_dense.npy

# ---------------------------------------------------------------
# Deliverable branch (deliverable/2026-09) — excluded from the repo
# ---------------------------------------------------------------
# Regenerable vector/sparse indexes. ~92MB of .npy/.pkl that do not
# diff, and which are rebuilt by scripts/build_corpus_dense.py,
# build_sparse_index.py and build_date_index.py from corpus/ + config.
data/index/

# Working backups taken during correction batch-03 and intake batch-04.
# Safety copies for the September runs, not part of the deliverable.
batch-03/backup_*/
batch-03/backup_*.jsonl
batch-04/backup_*/
batch-04/_transfer_archive/
